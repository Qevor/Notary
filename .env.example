NOTARY_ENV=development
NOTARY_DEMO_MODE=false
NOTARY_DEFAULT_PRIVACY_MODE=protected
NOTARY_DB_PATH=.notary/notary.sqlite3
NOTARY_SESSION_SECRET=
# Generate with: openssl rand -hex 32
VALIDATOR_PRIVATE_KEY=
# EVM private key for EIP-712 verdict signing — use a testnet-only key
VALIDATOR_EIP712_NAME=NOTARY
VALIDATOR_EIP712_VERSION=1

API_HOST=0.0.0.0
API_PORT=8000

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_API_BASE_URL=https://api.anthropic.com
GROQ_API_KEY=
# Get from: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com

ARC_DEMO_MODE=false
ARC_RPC_URL=
# Arc Testnet chain ID — get from arc-canteen or the Arc node docs
ARC_CHAIN_ID=
# Hackathon submission/tracking CLI — installed as arc-canteen
ARC_CLI_PATH=arc-canteen
# EVM private key for signing and submitting Arc contract calls (testnet only)
ARC_OPERATOR_PRIVATE_KEY=
# Contract addresses — output of `python scripts/deploy_arc.py` after `forge build`
ARC_NOTARY_IDENTITY_REGISTRY=
ARC_ATTESTATION_REGISTRY=
ARC_VALIDATION_REGISTRY=
ARC_GOVERNANCE=

CIRCLE_CLI_PATH=circle
CIRCLE_WALLET_EMAIL=
CIRCLE_CHAIN=ARC-TESTNET
CIRCLE_TESTNET=true
CIRCLE_GATEWAY_ENABLED=true
CIRCLE_PAYMASTER_ENABLED=true

QEVORPAY_DEMO_MODE=false
QEVORPAY_API_BASE_URL=
QEVORPAY_API_KEY=
QEVORPAY_WEBHOOK_SECRET=
QEVORPAY_PAYMENT_LINK_PATH=
QEVORPAY_BATCH_DISTRIBUTION_PATH=
QEVORPAY_RELEASE_ESCROW_PATH=
QEVORPAY_REFUND_PATH=
QEVORPAY_PAYMENT_STATUS_PATH_TEMPLATE=
QEVORPAY_WEBHOOK_SIGNATURE_HEADER=x-signature
# Qevor Supabase — get from: Supabase project settings → API (use service role key server-side only)
QEVOR_SUPABASE_URL=
QEVOR_SUPABASE_ANON_KEY=
QEVOR_SUPABASE_SERVICE_ROLE_KEY=

SPEECHMATICS_DEMO_MODE=false
SPEECHMATICS_API_BASE_URL=https://asr.api.speechmatics.com/v2
SPEECHMATICS_API_KEY=
# Get from: https://portal.speechmatics.com/api-keys
SPEECHMATICS_TRANSCRIPTIONS_PATH=/jobs
SPEECHMATICS_TRANSCRIPTION_STATUS_PATH_TEMPLATE=/jobs/{job_id}
SPEECHMATICS_TRANSCRIPT_PATH_TEMPLATE=/jobs/{job_id}/transcript?format=json-v2
SPEECHMATICS_LANGUAGE=en
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_DIARIZATION=speaker

IPFS_API_BASE_URL=
IPFS_API_KEY=
EVIDENCE_VAULT_LOCAL_DIR=.notary_vault
EVIDENCE_VAULT_PASSPHRASE=

X_API_KEY=
X_API_SECRET=
